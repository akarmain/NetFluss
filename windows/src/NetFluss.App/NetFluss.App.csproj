<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows 10 2004 SDK projection, for the per-app data-usage records behind app
      statistics (Windows.Networking.Connectivity). 2004 is also the floor for
      SetInterfaceDnsSettings, so it costs no supported system.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>NetFluss.App</RootNamespace>
    <AssemblyName>NetFluss</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetFluss.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <!--
    A release publish (build-release.ps1 passes a RuntimeIdentifier) is one NetFluss.exe with
    every managed assembly inside it. Until the release is code-signed, each loose unsigned
    DLL is one more file Smart App Control may refuse — and some load only when a feature is
    first used, so a refusal ended the app minutes after it started. The native libraries
    (WPF's renderer, WebView2's loader) stay beside it: Microsoft signs them, and bundling
    would unpack them into %TEMP% at every start, where Application Control blocks code.
    Not compressed: a compressed bundle keeps every assembly unpacked in private memory for
    the life of the process — measured at 210 MB against 108 MB for an app that runs all day.
    The installer and the zip compress it anyway, so downloads are no larger.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- The WebView2 package's IntelliSense files are no use to anyone running the app. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\NetFluss.ico" />
    <Resource Include="Assets\NetFluss.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!--
      The speed test runs the macOS app's own HTML/JS unchanged. Only the host bridge is
      ported, which is what keeps the two platforms measuring the same way. The Evergreen
      runtime ships with Windows 11; the WiX installer will need to bootstrap it for
      Windows 10.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shared verbatim with macOS rather than copied into windows/. These files are the test:
      forking them would mean the two platforms silently start reporting different numbers.
    -->
    <Content Include="..\..\..\Packaging\Resources\SpeedTest\**\*.*"
             Link="SpeedTest\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetFluss.Core/NetFluss.Core.csproj" />
    <ProjectReference Include="../NetFluss.Native/NetFluss.Native.csproj" />
    <ProjectReference Include="../NetFluss.Tray/NetFluss.Tray.csproj" />
    <!--
      Built first but not referenced: the helper is a separate executable that runs as a
      service, and it ships in a folder of its own beside the app so its installer can copy
      exactly that folder into Program Files.
    -->
    <ProjectReference Include="../NetFluss.Service/NetFluss.Service.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyHelper" AfterTargets="Build">
    <ItemGroup>
      <!-- Not the win-x64/win-arm64 folders a RID-specific build or publish of the helper leaves there. -->
      <HelperFiles Include="$(MSBuildProjectDirectory)\..\NetFluss.Service\bin\$(Configuration)\net10.0-windows\**\*.*"
                   Exclude="$(MSBuildProjectDirectory)\..\NetFluss.Service\bin\$(Configuration)\net10.0-windows\win-*\**" />
    </ItemGroup>
    <Copy SourceFiles="@(HelperFiles)"
          DestinationFiles="@(HelperFiles->'$(OutDir)Helper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
