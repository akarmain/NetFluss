<Window x:Class="NetFluss.App.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetFluss"
        Width="340"
        MinWidth="300"
        MinHeight="140"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource PopoverBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary Source="PopoverResources.xaml" />
    </Window.Resources>

    <!--
        WindowChrome rather than AllowsTransparency. A layered window is rendered in software
        and gets neither the DWM shadow nor Windows 11's rounded corners; this way the popover
        is an ordinary frame with its caption removed, so the shell draws both, and the resize
        border comes from the system instead of a hand-written hit test.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- Header: the pin button top-right, as on macOS. Doubles as the drag handle when pinned. -->
        <Grid x:Name="Header" DockPanel.Dock="Top" Margin="10,6,8,0" Background="Transparent">
            <TextBlock x:Name="PinnedTitle"
                       Text="NetFluss"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource PopoverSecondaryBrush}" />
            <Button x:Name="PinButton"
                    HorizontalAlignment="Right"
                    Style="{StaticResource NfIconButton}"
                    Width="24"
                    Height="24"
                    FontSize="11" />
        </Grid>

        <!-- Footer: quick access to the app's windows, Preferences and Quit. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PopoverDividerBrush}">
            <Grid Margin="8,4,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus"
                           Grid.Column="0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PopoverTertiaryBrush}" />
                <StackPanel x:Name="FooterButtons" Grid.Column="1" Orientation="Horizontal" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="SectionHost" />
        </ScrollViewer>
    </DockPanel>
</Window>
