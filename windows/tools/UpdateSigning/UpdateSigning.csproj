<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Signs a release's SHA256SUMS.txt for the in-app updater, and makes the key pair the
    updater checks it with. See NetFluss.Core/UpdateSignature.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NetFluss.Tools.UpdateSigning</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetFluss.Core\NetFluss.Core.csproj" />
  </ItemGroup>

</Project>
